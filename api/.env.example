# --- Infra (Railway: use reference variables, e.g. ${{Postgres.DATABASE_URL}}) ---
DATABASE_URL=postgresql://localhost:5432/ask_your_data
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
# Local dev: your default OpenAI key is fine (this file is git-ignored).
# Railway/production: use the dedicated project-scoped demo key with a spend limit. NEVER the default key.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini   # title, condense, chart spec, free-text extraction
OPENAI_MODEL_SQL=gpt-4o         # text-to-SQL + analysis (benchmark and adjust, see CLAUDE.md open questions)
# FAKE_LLM=1                    # offline canned answers for UI work (no OpenAI calls); ignored when unset

# --- Free-taste gate ---
FREE_ACTIONS=3                  # set to 1 locally to reach the "blocked" state fast
GATE_NAMESPACE=ask-your-data    # Redis key prefix; lets several demos share one Redis
GATE_TTL_DAYS=7

# --- Ops ---
LOG_LEVEL=INFO
ENABLE_DOCS=1                  # /docs + /openapi.json; leave unset (disabled) in production
MAX_ACTIVE_DATASETS=300        # shared-DB cap across all visitors; new uploads get 503 beyond it

# --- Dataset limits ---
DATASET_TTL_HOURS=24
MAX_UPLOAD_MB=5
MAX_TOTAL_ROWS=50000
MAX_TABLES=5
MAX_COLUMNS_PER_TABLE=50
MAX_RESULT_ROWS=500
SQL_STATEMENT_TIMEOUT_MS=5000
